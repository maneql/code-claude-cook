{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit", "Write", "Read", "Grep", "Glob",
      "Bash(npm:*)", "Bash(npx:*)", "Bash(pnpm:*)", "Bash(yarn:*)", "Bash(node:*)",
      "Bash(python:*)", "Bash(python3:*)", "Bash(pytest:*)", "Bash(pip:*)", "Bash(pip3:*)", "Bash(ruff:*)", "Bash(black:*)",
      "Bash(go:*)", "Bash(cargo:*)", "Bash(make:*)", "Bash(mvn:*)", "Bash(./gradlew:*)", "Bash(dotnet:*)", "Bash(csharpier:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git add:*)", "Bash(git log:*)", "Bash(git init:*)", "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git branch:*)", "Bash(git stash:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(mkdir:*)", "Bash(rg:*)", "Bash(grep:*)", "Bash(sed:*)", "Bash(awk:*)", "Bash(find:*)", "Bash(echo:*)", "Bash(touch:*)", "Bash(cp:*)", "Bash(mv:*)"
    ],
    "deny": [
      "Bash(git commit:*)", "Bash(git push:*)", "Bash(sudo:*)",
      "Bash(git reset --hard:*)", "Bash(git clean:*)", "Bash(git restore:*)", "Bash(git stash drop:*)", "Bash(git stash clear:*)",
      "PowerShell(git commit:*)", "PowerShell(git push:*)", "PowerShell(git reset --hard:*)", "PowerShell(git clean:*)", "PowerShell(git restore:*)", "PowerShell(git stash drop:*)", "PowerShell(git stash clear:*)"
    ]
  }
}
